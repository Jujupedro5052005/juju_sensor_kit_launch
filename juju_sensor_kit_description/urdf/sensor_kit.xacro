<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
      
    <xacro:arg name="config_dir" default="$(find juju_sensor_kit_description)/config"/>

    <xacro:property name="sensor_kit_base_link" value="sensor_kit_base_link"/>
    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>
    
    <!-- Include xacro LIDAR RS-Helios-16P -->
    <xacro:include filename="$(find juju_sensor_kit_description)/urdf/rs_helios_16p_macro.xacro"/>
    
    <!-- Include xacro RADAR ARS408 -->
    <xacro:include filename="$(find juju_sensor_kit_description)/urdf/ars408_macro.xacro"/>

    <!-- Sensor kit base -->
    <joint name="${sensor_kit_base_link}_joint" type="fixed">
      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
      <parent link="${parent}"/>
      <child link="${sensor_kit_base_link}"/>
    </joint>

    <link name="${sensor_kit_base_link}">
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </link>

    <!-- LiDAR RS-Helios-16P -->
    <xacro:rs_helios_16p_macro
      parent="${sensor_kit_base_link}"
      x="${calibration['sensor_kit_base_link']['rs_helios_top_base_link']['x']}"
      y="${calibration['sensor_kit_base_link']['rs_helios_top_base_link']['y']}"
      z="${calibration['sensor_kit_base_link']['rs_helios_top_base_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['rs_helios_top_base_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['rs_helios_top_base_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['rs_helios_top_base_link']['yaw']}"
    />
    
    <!-- RADAR ARS408 -->
    <xacro:ars408_macro
      parent="${sensor_kit_base_link}"
      x="${calibration['sensor_kit_base_link']['ars408_mid_base_link']['x']}"
      y="${calibration['sensor_kit_base_link']['ars408_mid_base_link']['y']}"
      z="${calibration['sensor_kit_base_link']['ars408_mid_base_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['ars408_mid_base_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['ars408_mid_base_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['ars408_mid_base_link']['yaw']}"
    />
  </xacro:macro>

</robot>

