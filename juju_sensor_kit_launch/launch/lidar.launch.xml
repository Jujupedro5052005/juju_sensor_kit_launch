<launch>
  <!-- Argumentos -->
  <arg name="launch_driver" default="true"/>
  <arg name="launch_rviz" default="false"/>
  <arg name="rviz_file" default="$(find-pkg-share rslidar_sdk)/rviz/rviz2.rviz"/>

  <!-- Grupo do LiDAR -->
  <group>
    <push-ros-namespace namespace="lidar"/>

    <!-- Nó principal do driver -->
    <node
      pkg="rslidar_sdk"
      exec="rslidar_sdk_node"
      output="screen"
      if="$(var launch_driver)">
    </node>

    <!-- RViz, controlado por flag -->
    <node
      pkg="rviz2"
      exec="rviz2"
      name="rviz2"
      output="screen"
      args="-d $(var rviz_file)"
      if="$(var launch_rviz)"/>
  </group>
</launch>

